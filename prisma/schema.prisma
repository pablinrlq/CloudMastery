generator kysely {
  provider           = "prisma-kysely"
  output             = "../src/generated/kysely"
  fileName           = "types.ts"
  dbTypeName         = "Database"
  exportWrappedTypes = true
  readOnlyIds        = true
  banner             = "// Generated by prisma-kysely. Do not edit manually."
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @default(now()) @db.Timestamptz

  sessions          Session[]
  accounts          Account[]
  subscriptions     Subscription[]
  progress          UserProgress[]
  attempts          SimuladoAttempt[]
  flashcardProgress UserFlashcardProgress[]

  @@map("user")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @db.Timestamptz
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @default(now()) @db.Timestamptz
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issuer                String
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz
  refreshTokenExpiresAt DateTime? @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz
  updatedAt             DateTime  @default(now()) @db.Timestamptz
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @default(now()) @db.Timestamptz

  @@index([identifier])
  @@map("verification")
}

model Certification {
  id                  String   @id
  name                String
  code                String
  examDurationMinutes Int      @map("exam_duration_minutes")
  examQuestionCount   Int      @map("exam_question_count")
  passingScore        Int      @map("passing_score")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  modules    Module[]
  questions  Question[]
  attempts   SimuladoAttempt[]
  flashcards Flashcard[]

  @@map("certifications")
}

model Module {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  certId     String         @map("cert_id")
  slug       String
  title      String
  domain     String?
  orderIndex Int            @map("order_index")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz
  cert       Certification  @relation(fields: [certId], references: [id], onDelete: Cascade)
  progress   UserProgress[]

  @@unique([certId, slug])
  @@map("modules")
}

model Subscription {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @unique @map("user_id") @db.Uuid
  stripeCustomerId     String    @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  /// @kyselyType('trialing' | 'active' | 'past_due' | 'canceled' | 'incomplete' | 'incomplete_expired' | 'unpaid' | 'paused')
  status               String    @default("incomplete")
  /// @kyselyType('monthly' | 'annual' | null)
  plan                 String?
  certAccess           String[]  @default([]) @map("cert_access")
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model UserProgress {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  moduleId      String   @map("module_id") @db.Uuid
  /// @kyselyType('not_started' | 'in_progress' | 'completed')
  status        String   @default("not_started")
  lastVisitedAt DateTime @default(now()) @map("last_visited_at") @db.Timestamptz
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module        Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@map("user_progress")
}

model Question {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  certId           String        @map("cert_id")
  domain           String
  prompt           String
  choices          Json
  correctChoiceIds String[]      @map("correct_choice_ids")
  explanation      String?
  /// @kyselyType('easy' | 'medium' | 'hard')
  difficulty       String        @default("medium")
  hint             String?
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  cert             Certification @relation(fields: [certId], references: [id], onDelete: Cascade)

  @@map("questions")
}

model SimuladoAttempt {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String        @map("user_id") @db.Uuid
  certId              String        @map("cert_id")
  /// @kyselyType('full' | 'domain' | 'diagnostic')
  mode                String
  domain              String?
  /// @kyselyType(number | string | null)
  score               Decimal?      @db.Decimal
  scoreNoPenalty      Int?          @map("score_no_penalty")
  timeSpentSeconds    Int?          @map("time_spent_seconds")
  answers             Json          @default("{}")
  domainBreakdown     Json?         @map("domain_breakdown")
  questionTimings     Json?         @map("question_timings")
  hintsUsed           Json          @default("[]") @map("hints_used")
  overtimeSeconds     Int?          @map("overtime_seconds")
  selectedQuestionIds String[]      @default([]) @map("selected_question_ids") @db.Uuid
  startedAt           DateTime      @default(now()) @map("started_at") @db.Timestamptz
  completedAt         DateTime?     @map("completed_at") @db.Timestamptz
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cert                Certification @relation(fields: [certId], references: [id], onDelete: Cascade)

  @@map("simulado_attempts")
}

model Flashcard {
  id        String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  certId    String                  @map("cert_id")
  domain    String?
  front     String
  back      String
  createdAt DateTime                @default(now()) @map("created_at") @db.Timestamptz
  cert      Certification           @relation(fields: [certId], references: [id], onDelete: Cascade)
  progress  UserFlashcardProgress[]

  @@map("flashcards")
}

model UserFlashcardProgress {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  flashcardId    String    @map("flashcard_id") @db.Uuid
  /// @kyselyType('new' | 'review_later' | 'known')
  status         String    @default("new")
  lastReviewedAt DateTime  @default(now()) @map("last_reviewed_at") @db.Timestamptz
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard      Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId])
  @@map("user_flashcard_progress")
}
