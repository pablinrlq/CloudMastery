# PostgreSQL + Better Auth
DATABASE_URL=
# Use `disable` apenas no PostgreSQL local sem TLS.
DATABASE_SSL=disable
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Envio de confirmação e recuperação por SMTP (em dev, o link é impresso no terminal se não configurar SMTP).
SMTP_HOST=
SMTP_PORT=587
# true para TLS direto (normalmente porta 465); false para STARTTLS obrigatório (normalmente porta 587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
AUTH_EMAIL_FROM=Cloud Mastery <auth@example.com>
# OAuth Google opcional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (Developers > API keys)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Developers > Webhooks > signing secret (or from `stripe listen` in dev)
STRIPE_WEBHOOK_SECRET=
# Price IDs from Products > your subscription product
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# Public origin used for OAuth and Stripe callbacks (no trailing path).
# Example: https://cloudmastery.com.br
NEXT_PUBLIC_SITE_URL=

# Exiba login Google somente depois de habilitar o provider no Supabase e
# configurar Client ID/Secret e redirect URI no Google Cloud Console.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
